policy_module(privacyidea-pam-selinux, 1.0)

########################################
#
# Declarations
#

type privacyidea_pam_offline_t;
files_type(privacyidea_pam_offline_t)

########################################
#
# Requirements
#

require {
    type sshd_t;
    type http_port_t;
}

########################################
#
# privacyIDEA PAM policy
#

# Allow privacyIDEA PAM running in the SSH daemon
# domain to connect to the privacyIDEA server
# via HTTP/HTTPS.
allow sshd_t http_port_t:tcp_socket name_connect;

# Allow privacyIDEA PAM running in the SSH daemon
# domain to read and update the offline token file.
allow sshd_t privacyidea_pam_offline_t:file {
    getattr
    open
    read
    write
};
